<Window x:Class="IceCream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IceCream"
        mc:Ignorable="d"
        Title="Ice Cream Check-out" FontSize="16" 
        Height="450" MinHeight="300"
        Width="400" MinWidth="300"
        Icon="/2019 07 Canada Vortex.jpg">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="LightGreen"/>
            <GradientStop Color="White" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
            <RadioButton x:Name="radioMini" Content="_Mini scoop" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="True" ToolTip="Click if ordering a mini scoop" />
            <RadioButton x:Name="radioOneScoop" Content="_One scoop" HorizontalAlignment="Left" ToolTip="Click if ordering one scoop" />
            <RadioButton x:Name="radioTwoScoop" Content="_Two scoops" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Click if ordering two scoops" />
            <RadioButton x:Name="radioThreeScoop" Content="T_hree scoops" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Click if ordering three scoops" />
        </StackPanel>

        <CheckBox x:Name="checkWaffle" Content="_Waffle Cone" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Click if you want to upgrade to a waffle cone" Grid.Column="1"/>

        <Button Content="_Add to Order" HorizontalAlignment="Center" VerticalAlignment="Center" Click="AddToOrder" ToolTip="Click to add the selected cone to the order" IsDefault="True" Grid.Row="1" Grid.Column="0" Width="120"/>
        <Button Content="Clea_r" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ResetClick" ToolTip="Click to reset the form" Grid.Row="1" Grid.Column="1" Width="120"/>

        <Label Content="_Subtotal:" HorizontalAlignment="Right" Grid.Row="2" Target="{Binding ElementName=textSubtotal}" VerticalAlignment="Center"/>
        <TextBox x:Name="textSubtotal" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" IsReadOnly="True" ToolTip="Displays the subtotal" Grid.Row="2" Grid.Column="1"/>

        <Label Content="Ta_x:" HorizontalAlignment="Right" VerticalAlignment="Center" Target="{Binding ElementName=textTax}" Grid.Row="3"/>
        <TextBox x:Name="textTax" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" IsReadOnly="True" ToolTip="Display the tax" Grid.Row="3" Grid.Column="1"/>

        <Label Content="Tota_l:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="4" Target="{Binding ElementName=textTotal, Mode=OneWay}"/>
        <TextBox x:Name="textTotal" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" IsReadOnly="True" ToolTip="Display the overall total" Grid.Row="4" Grid.Column="1"/>
    </Grid>
</Window>
